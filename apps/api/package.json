{
    "name": "@ayopa/api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "nest build",
        "start": "node dist/main",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "lint": "eslint . --ext .ts",
        "test": "jest",
        "typeorm": "npx typeorm-ts-node-commonjs -d src/database/data-source.ts",
        "seed": "npx ts-node -r tsconfig-paths/register src/database/seed.ts",
        "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/$npm_config_name",
        "migration:run": "npm run typeorm -- migration:run",
        "migration:revert": "npm run typeorm -- migration:revert"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.28",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.28",
        "@nestjs/swagger": "^11.4.6",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/typeorm": "^11.0.3",
        "@otplib/plugin-crypto-noble": "^13.4.1",
        "@otplib/totp": "^13.4.1",
        "@types/bcrypt": "^6.0.0",
        "@types/nodemailer": "^8.0.1",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.0",
        "class-validator": "^0.14.0",
        "compression": "^1.8.1",
        "express": "^4.21.2",
        "helmet": "^8.0.0",
        "nodemailer": "^9.0.3",
        "otplib": "^13.4.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.4.0",
        "redis": "^4.7.1",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.4.0",
        "typeorm": "^0.3.21"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.24",
        "@nestjs/testing": "^11.1.28",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.3.0",
        "typeorm-ts-node-commonjs": "^0.3.20"
    }
}
